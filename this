#!/bin/bash

GLOBAL_DB="$HOME/.this_commands"
touch "$GLOBAL_DB"

get_local_files() {
    shopt -s nullglob
    echo *.this
    shopt -u nullglob
}

if [ -n "$1" ]; then
    cmd="$1"
    printf "Description: "
    read -r desc
    [ -z "$desc" ] && desc="No description"
    
    local_files=($(get_local_files))
    
    if [ ${#local_files[@]} -gt 0 ]; then
        echo "Select where to save the command:"
        echo "1) Global ($GLOBAL_DB)"
        int=2
        for f in "${local_files[@]}"; do
            echo "$int) Local ($f)"
            int=$((int+1))
        done
        printf "Choice [1-$((int-1))]: "
        read -r choice
        
        if [ "$choice" -gt 1 ] && [ "$choice" -lt "$int" ]; then
            TARGET_DB="${local_files[$((choice-2))]}"
        else
            TARGET_DB="$GLOBAL_DB"
        fi
    else
        TARGET_DB="$GLOBAL_DB"
    fi

    echo "$desc | $cmd" >> "$TARGET_DB"
    exit 0
fi

get_combined_list() {
    if [ -f "$GLOBAL_DB" ]; then
        cat -n "$GLOBAL_DB" | sed 's/^[[:space:]]*//' | awk -v path="$GLOBAL_DB" '{print $0 " | " path}'
    fi
    
    shopt -s nullglob
    for f in *.this; do
        if [ -f "$f" ]; then
            cat -n "$f" | sed 's/^[[:space:]]*//' | awk -v path="$f" '{print $0 " | " path}'
        fi
    done
    shopt -u nullglob
}

export -f get_combined_list
export GLOBAL_DB

local_exists=0
shopt -s nullglob
for f in *.this; do [ -f "$f" ] && local_exists=1 && break; done
shopt -u nullglob

if [ ! -s "$GLOBAL_DB" ] && [ "$local_exists" -eq 0 ]; then
    echo "Command list is empty."
    exit 0
fi

selected=$(get_combined_list | fzf \
    --header "ENTER: Run | CTRL-D: Delete | ESC: Exit" \
    --with-nth 2.. \
    --preview "echo {2..}" \
    --preview-window="bottom:3:wrap" \
    --bind "ctrl-d:execute-silent(
        line_num=\$(echo {} | awk '{print \$1}');
        origin=\$(echo {} | awk -F' | ' '{print \$NF}');
        sed -i \"\${line_num}d\" \"\$origin\"
    )+reload(bash -c get_combined_list)" \
    --height 40% --reverse)

if [ -n "$selected" ]; then
    clean_line=$(echo "$selected" | sed 's/^[0-9]\+[[:space:]]*//' | sed 's/ | .*$//')
    cmd_to_run="${clean_line#* | }"

    while [[ "$cmd_to_run" =~ \{\{([^}]+)\}\} ]]; do
        full_match="${BASH_REMATCH[0]}"
        inner="${BASH_REMATCH[1]}"

        is_optional=false
        val=""

        if [[ "$inner" == *":"* ]]; then
            label_part="${inner%%:*}"
            options_raw="${inner#*:}"

            if [[ "$label_part" == *"?" ]]; then
                is_optional=true
                label="${label_part%?}"
                options_raw="(None),$options_raw"
            else
                label="$label_part"
            fi

            val=$(echo "$options_raw" | tr ',' '\n' | fzf --height 15% --reverse --header "Select $label:")

            if [[ "$val" == "(None)" ]] || [[ -z "$val" && "$is_optional" = true ]]; then
                val=""
            fi
        else
            label_part="$inner"
            if [[ "$label_part" == *"?" ]]; then
                is_optional=true
                label="${label_part%?}"
            else
                label="$label_part"
            fi

            while true; do
                prompt_text="\033[1;34m$label\033[0m"
                [ "$is_optional" = true ] && prompt_text="$prompt_text [optional]"

                printf "$prompt_text: "
                read -r val

                if [ -z "$val" ] && [ "$is_optional" = false ]; then
                    echo -e "\033[0;31mError: $label is required.\033[0m"
                    continue
                fi
                break
            done
        fi

        cmd_to_run="${cmd_to_run//"$full_match"/$val}"
    done

    echo -e "\n\033[1;32mExecuting:\033[0m $cmd_to_run\n"
    eval "$cmd_to_run"
fi